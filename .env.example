# ===== ClauseWise Docker Compose 运行时配置模板 =====
# 复制为 .env 后填入真实值：cp .env.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_DATABASE=contract_compliance
MYSQL_USER=clausewise
MYSQL_PASSWORD=change_me_pwd
MYSQL_HOST_PORT=13306

# ---------- Redis ----------
REDIS_HOST_PORT=16379
REDIS_PASSWORD=change_me_redis_password

# ---------- Elasticsearch（启用认证，密码不能为空）----------
ES_HOST_PORT=19200
ES_USERNAME=elastic
ES_PASSWORD=change_me_es_password

# ===== 方案 A（推荐）：经 LiteLLM 网关统一出口 =====
# 真实厂商、模型、备模型、超时、熔断、日志脱敏全部在 docker/litellm/config.yaml 里配置；
# 应用侧只认别名，换模型只需改网关配置并 docker compose restart litellm
LITELLM_HOST_PORT=14000
LITELLM_MASTER_KEY=change_me_litellm_master_key
LLM_PROVIDER=custom
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=change_me_litellm_master_key
LLM_MODEL=contract-review
# 扫描件 OCR 通道专用别名（留空复用主模型）
LLM_VISION_MODEL=contract-ocr
# 部分厂商不支持 stream_options.include_usage，遇 400 时置 false
LLM_STREAM_USAGE=

# ===== 方案 B：直连厂商（不经网关；与方案 A 二选一）=====
# 回滚方法：把上面 5 行改成下面的直连配置即可，无需改代码、无需重建镜像
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# 各厂商密钥（方案 A/B 都需要，网关经 os.environ 读取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 向量模型（换模型必须重建 ES 索引，见 README）----------
# 可选厂商：dashscope / openai / zhipu / siliconflow / ollama / custom
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# bge-m3 等自部署向量模型不认 dimensions 参数，置 false
EMBEDDING_SEND_DIMENSIONS=

# ---------- 其它厂商密钥（按 LLM_PROVIDER / EMBEDDING_PROVIDER 自动取用，留空即可）----------
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# SILICONFLOW_API_KEY=
# ARK_API_KEY=

# ---------- 自定义端点（自建 vLLM / OneAPI 网关 / 公司代理）----------
# 用法：LLM_PROVIDER=custom，再填下面三项（向量模型同理，用 EMBEDDING_BASE_URL / EMBEDDING_API_KEY）
# LLM_BASE_URL=https://your-gateway/v1
# LLM_API_KEY=


# ---------- 告警外发（审查/解析任务失败时推送）----------
# 按 URL 自动适配载荷：企业微信 / 钉钉 / 飞书机器人，或任意接收 JSON 的自建端点
# 示例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# 开启开关；URL 留空时告警静默（不影响任何业务流程），填入机器人地址即生效
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
# 同一事件（按任务 ID）的限频秒数，避免 Celery 重试刷屏
ALERT_MIN_INTERVAL_SECONDS=300
ALERT_SERVICE_NAME=clausewise
# Alertmanager 回调应用告警入口的共享令牌（随机串，与下面 ALERT_INGEST_TOKEN 一致）
ALERT_INGEST_TOKEN=change_me_alert_ingest_token

# ---------- 指标与阈值告警（Prometheus / Alertmanager）----------
PROMETHEUS_HOST_PORT=19090
ALERTMANAGER_HOST_PORT=19093

# ---------- 构建期依赖源（可选）----------
# 容器网络无法直连官方 PyPI（files.pythonhosted.org）时填写镜像源；留空走官方源
# 例：UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
UV_INDEX_URL=

# ---------- 应用 ----------
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_random_secret
ACCESS_TOKEN_EXPIRE_DAYS=7
LLM_CONCURRENCY=8

# ---------- 账号安全 ----------
# 初始管理员（admin）口令：首次启动写入账号，首次登录强制改密
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- 预制（演示）账号 ----------
# 仅演示/试用环境开启。开启后 backend/app/core/preset_accounts.py 中的账号
# 统一使用 PRESET_ACCOUNT_PASSWORD 直接登录（不强制改密），登录页展示一键填充卡片。
# 关闭时启动会回收这些账号（停用 + 令牌失效），生产环境务必保持 false。
PRESET_ACCOUNTS_ENABLED=false
# 预制账号统一口令（≥12 字符、≤72 字节、去重字符 ≥4）；留空回落到内置 ClauseWise@2026Demo
PRESET_ACCOUNT_PASSWORD=

# ---------- 端口映射（宿主机）----------
API_HOST_PORT=18000
FRONTEND_HOST_PORT=15173
